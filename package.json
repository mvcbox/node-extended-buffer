{
  "name": "extended-buffer",
  "version": "7.1.1",
  "description": "Node JS extended Buffer",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && node ./node_modules/.bin/tsc",
    "test": "node ./node_modules/.bin/mocha",
    "coverage": "node ./node_modules/.bin/nyc --reporter=html --reporter=text ./node_modules/.bin/mocha",
    "clean": "node -e \"['./dist', './coverage', './.nyc_output'].forEach(item => require('fs').rmSync(item, {recursive:true,force:true}));\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=6.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=18.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=8.6.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvcbox/node-extended-buffer.git"
  },
  "keywords": [
    "Buffer",
    "Binary data"
  ],
  "author": "mvcbox.org@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mvcbox/node-extended-buffer/issues"
  },
  "homepage": "https://github.com/mvcbox/node-extended-buffer#readme",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^6.14.13",
    "chai": "^4.5.0",
    "mocha": "^6.2.3",
    "nyc": "^11.9.0",
    "typescript": "^4.7.2"
  }
}
